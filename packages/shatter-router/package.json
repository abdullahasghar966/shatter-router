{
  "name": "shatter-router",
  "version": "0.1.0",
  "description": "Physically convincing WebGL2 glass-shatter page transitions for single-page apps.",
  "keywords": [
    "page-transition",
    "route-transition",
    "webgl",
    "webgl2",
    "shatter",
    "glass",
    "voronoi",
    "react",
    "nextjs",
    "react-router"
  ],
  "license": "MIT",
  "author": "Abdullah Asghar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdullahasghar966/shatter-router.git",
    "directory": "packages/shatter-router"
  },
  "homepage": "https://github.com/abdullahasghar966/shatter-router#readme",
  "bugs": "https://github.com/abdullahasghar966/shatter-router/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "import": "./dist/react-router.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./rapier": {
      "types": "./dist/rapier.d.ts",
      "import": "./dist/rapier.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "core (shatter-router)",
      "path": "dist/index.js",
      "import": "*",
      "ignore": [
        "./runtime.js",
        "./engine.js",
        "./capture.js"
      ],
      "gzip": true,
      "limit": "6 KB"
    },
    {
      "name": "react (shatter-router/react, incl. core)",
      "path": "dist/react.js",
      "import": "*",
      "ignore": [
        "./runtime.js",
        "./engine.js",
        "./capture.js",
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "gzip": true,
      "limit": "6 KB"
    },
    {
      "name": "react-router (shatter-router/react-router, incl. core and react)",
      "path": "dist/react-router.js",
      "import": "*",
      "ignore": [
        "./runtime.js",
        "./engine.js",
        "./capture.js",
        "react",
        "react-dom",
        "react/jsx-runtime",
        "react-router"
      ],
      "gzip": true,
      "limit": "6 KB"
    },
    {
      "name": "next (shatter-router/next, incl. core and react)",
      "path": "dist/next.js",
      "import": "*",
      "ignore": [
        "./runtime.js",
        "./engine.js",
        "./capture.js",
        "react",
        "react-dom",
        "react/jsx-runtime",
        "next",
        "next/link",
        "next/navigation"
      ],
      "gzip": true,
      "limit": "6 KB"
    },
    {
      "name": "rapier (shatter-router/rapier, the plugin descriptor)",
      "path": "dist/rapier.js",
      "import": "*",
      "ignore": [
        "./rapier-backend.js",
        "@dimforge/rapier3d-compat"
      ],
      "gzip": true,
      "limit": "1 KB"
    },
    {
      "name": "rapier-backend chunk (lazy: simulation; Rapier itself is a peer)",
      "path": "dist/rapier-backend.js",
      "import": "*",
      "ignore": [
        "@dimforge/rapier3d-compat"
      ],
      "gzip": true,
      "limit": "3 KB"
    },
    {
      "name": "runtime chunk (lazy: state machine, fallbacks, a11y, navigation memory)",
      "path": "dist/runtime.js",
      "import": "*",
      "ignore": [
        "./engine.js",
        "./capture.js",
        "./debug.js"
      ],
      "gzip": true,
      "limit": "10 KB"
    },
    {
      "name": "debug chunk (lazy: debug panel and seam check, debug mode only)",
      "path": "dist/debug.js",
      "import": "*",
      "gzip": true,
      "limit": "5 KB"
    },
    {
      "name": "engine core (lazy: renderer, mesh, stagger, plugin loading; ADR-048)",
      "path": "dist/engine.js",
      "import": "*",
      "ignore": [
        "./effects/shatter.js",
        "./effects/explode.js",
        "./effects/implode.js",
        "./effects/flip.js",
        "./effects/assemble.js",
        "./patterns/impact.js"
      ],
      "gzip": true,
      "limit": "15 KB"
    },
    {
      "name": "motion: shatter (lazy)",
      "path": "dist/effects/shatter.js",
      "import": "*",
      "gzip": true,
      "limit": "2 KB"
    },
    {
      "name": "motion: explode (lazy)",
      "path": "dist/effects/explode.js",
      "import": "*",
      "gzip": true,
      "limit": "2 KB"
    },
    {
      "name": "motion: implode (lazy)",
      "path": "dist/effects/implode.js",
      "import": "*",
      "gzip": true,
      "limit": "2 KB"
    },
    {
      "name": "motion: flip (lazy)",
      "path": "dist/effects/flip.js",
      "import": "*",
      "gzip": true,
      "limit": "2 KB"
    },
    {
      "name": "motion: assemble (lazy)",
      "path": "dist/effects/assemble.js",
      "import": "*",
      "gzip": true,
      "limit": "2 KB"
    },
    {
      "name": "pattern: impact (lazy, incl. d3-delaunay)",
      "path": "dist/patterns/impact.js",
      "import": "*",
      "gzip": true,
      "limit": "9 KB"
    },
    {
      "name": "capture chunk (lazy: DOM capture incl. modern-screenshot)",
      "path": "dist/capture.js",
      "import": "*",
      "gzip": true,
      "limit": "16 KB"
    }
  ],
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/d3-delaunay": "6.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "size-limit": "14.3.0",
    "tsup": "9.0.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "d3-delaunay": "6.0.6",
    "modern-screenshot": "4.7.0"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-router": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@dimforge/rapier3d-compat": {
      "optional": true
    }
  }
}
